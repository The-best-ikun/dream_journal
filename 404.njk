<style>
.error-404 {
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  position: relative;
  overflow: hidden;
}

.error-content {
  text-align: center;
  padding: 3rem;
  max-width: 600px;
  position: relative;
  z-index: 2;
}

.error-illustration {
  margin-bottom: 2rem;
  display: flex;
  justify-content: center;
}

.error-illustration svg {
  max-width: 300px;
  height: auto;
  animation: float 6s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

.error-title {
  font-size: 5rem;
  margin-bottom: 0.5rem;
    color: var(--text-primary);
.error-subtitle {
  font-size: 2rem;
  margin-bottom: 1rem;
  color: var(--text-primary);
}

.error-description {
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--text-secondary);
  margin-bottom: 2rem;
}

.error-actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.error-actions .btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 2rem;
  min-width: 150px;
  justify-content: center;
}

.search-suggestion {
  margin-top: 2rem;
}

.search-suggestion h3 {
  font-size: 1.3rem;
  margin-bottom: 1rem;
  color: var(--text-primary);
}

.suggestion-list {
  list-style: none;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 0.75rem;
}

.suggestion-list li {
  margin: 0;
}

.suggestion-list a {
  display: block;
  padding: 0.75rem 1rem;
  background: var(--bg-secondary);
  border-radius: 8px;
  color: var(--text-secondary);
  text-decoration: none;
  transition: all 0.3s ease;
  font-weight: 500;
}

.suggestion-list a:hover {
  background: var(--accent-light);
  color: white;
  transform: translateY(-2px);
}

/* 浮动装饰元素 */
.floating-elements {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
}

.floating-star {
  position: absolute;
  font-size: 1.5rem;
  animation: twinkle 3s ease-in-out infinite;
  animation-delay: var(--delay);
}

.floating-star:nth-child(1) { top: 10%; left: 10%; }
.floating-star:nth-child(2) { top: 20%; right: 15%; }
.floating-star:nth-child(3) { bottom: 30%; left: 20%; }
.floating-star:nth-child(4) { bottom: 15%; right: 25%; }

@keyframes twinkle {
  0%, 100% { 
    opacity: 0.3;
    transform: scale(0.8) rotate(0deg);
  }
  50% { 
    opacity: 1;
    transform: scale(1.2) rotate(180deg);
  }
}

/* 背景星空效果 */
.error-404::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    radial-gradient(2px 2px at 20% 30%, #FFAFCC, transparent),
    radial-gradient(2px 2px at 60% 70%, #A8DADC, transparent),
    radial-gradient(1px 1px at 50% 50%, #CCD5AE, transparent),
    radial-gradient(1px 1px at 80% 10%, #FFAFCC, transparent);
  background-size: 200px 200px;
  background-position: 0 0, 40px 60px, 130px 270px, 70px 100px;
  opacity: 0.3;
  animation: starfield 60s linear infinite;
  z-index: 0;
}

@keyframes starfield {
  0% { transform: translateY(0) rotate(0deg); }
  100% { transform: translateY(-200px) rotate(360deg); }
}

/* 响应式设计 */
@media (max-width: 768px) {
  .error-content {
    padding: 2rem 1.5rem;
  }
  
  .error-title {
    font-size: 3.5rem;
  }
  
  .error-subtitle {
    font-size: 1.5rem;
  }
  
  .error-description {
    font-size: 1rem;
  }
  
  .error-actions {
    flex-direction: column;
    align-items: center;
  }
  
  .error-actions .btn {
    width: 100%;
    max-width: 250px;
  }
  
  .suggestion-list {
    grid-template-columns: 1fr;
  }
  
  .floating-star {
    font-size: 1.2rem;
  }
}

/* 加载动画 */
.error-content {
  opacity: 0;
  transform: translateY(30px);
  animation: errorFadeIn 1s ease-out 0.5s forwards;
}

@keyframes errorFadeIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 深色模式适配 */
[data-theme="dark"] .error-illustration svg circle[fill="#2d3436"] {
  fill: #f1f2f6;
}

[data-theme="dark"] .error-illustration svg path[stroke="#2d3436"] {
  stroke: #f1f2f6;
}

[data-theme="dark"] .error-illustration svg ellipse[fill="#2d3436"] {
  fill: #f1f2f6;
}
</style>

<script>
// 404页面交互功能
document.addEventListener('DOMContentLoaded', function() {
  // 添加打字机效果到错误描述
  const description = document.querySelector('.error-description');
  if (description) {
    const originalText = description.textContent;
    description.textContent = '';
    let index = 0;
    
    function typeWriter() {
      if (index < originalText.length) {
        description.textContent += originalText.charAt(index);
        index++;
        setTimeout(typeWriter, 50);
      }
    }
    
    setTimeout(typeWriter, 1000);
  }
  
  // 随机生成更多星星
  function createStars() {
    const starContainer = document.querySelector('.floating-elements');
    if (!starContainer) return;
    
    for (let i = 0; i < 5; i++) {
      const star = document.createElement('div');
      star.className = 'floating-star';
      star.textContent = ['✨', '⭐', '💫', '🌟'][Math.floor(Math.random() * 4)];
      star.style.cssText = `
        top: ${Math.random() * 80 + 10}%;
        left: ${Math.random() * 80 + 10}%;
        --delay: ${Math.random() * 4}s;
        animation-duration: ${2 + Math.random() * 3}s;
      `;
      starContainer.appendChild(star);
    }
  }
  
  createStars();
  
  // 宇航员跟随鼠标轻微移动
  const astronaut = document.querySelector('.error-illustration svg g');
  if (astronaut) {
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 10;
      const y = (e.clientY / window.innerHeight - 0.5) * 10;
      astronaut.style.transform = `translate(${100 + x}px, ${100 + y}px)`;
    });
  }
});
</script>