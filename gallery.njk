---
layout: base.njk
title: 随手拍
description: 随手拍下的一些生活片段
keywords: 相册, 摄影, 生活, 瞬间, 美好
---

<section class="gallery-section">
  <div class="section-header">
    <h1 class="handwriting">随手拍</h1>
    <p class="section-subtitle">都是平时随手拍的，谈不上构图，就图个留档</p>
  </div>
  
  <div class="polaroid-wall" id="polaroidWall">
    {% for photo in collections.gallery %}
    <div class="polaroid-photo">
      <div class="polaroid-frame">
        <div class="photo-container">
          <img src="{{ photo.data.image }}" alt="{{ photo.data.title }}" loading="lazy">
        </div>
        
        <div class="polaroid-caption handwriting">
          <div class="photo-title">{{ photo.data.title }}</div>
          <div class="photo-date">{{ photo.data.date | date("yyyy.MM.dd") }}</div>
          <div class="photo-note">{{ photo.data.note }}</div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  
  <div class="gallery-loading" id="galleryLoading">
    <div class="loading-spinner"></div>
    <p>照片加载中…</p>
  </div>
</section>

<style>
.gallery-section {
  padding: 2rem 0;
  max-width: 1200px;
  margin: 0 auto;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-header h1 {
  font-size: 2.8rem;
  margin-bottom: 0.5rem;
}

.section-subtitle {
  font-size: 1.05rem;
  color: var(--text-secondary);
}

.polaroid-wall {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
  padding: 1rem 0;
}

.polaroid-photo {
  opacity: 1;
}

.polaroid-frame {
  background: var(--bg-card);
  padding: 0.75rem 0.75rem 2.5rem 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  cursor: pointer;
  transition: box-shadow 0.25s ease, transform 0.2s ease;
}

.polaroid-frame:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-4px);
}

.photo-container {
  position: relative;
  border-radius: 2px;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--bg-secondary);
}

.photo-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.polaroid-caption {
  margin-top: 0.75rem;
  text-align: center;
  color: var(--text-primary);
}

.photo-title {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.2rem;
  line-height: 1.3;
}

.photo-date {
  font-size: 0.8rem;
  color: var(--text-muted);
  font-family: 'SF Mono', 'Cascadia Code', monospace;
  letter-spacing: 0.03em;
  margin-bottom: 0.3rem;
}

.photo-note {
  font-size: 0.82rem;
  color: var(--text-secondary);
  line-height: 1.4;
  font-style: italic;
}

.gallery-loading {
  text-align: center;
  padding: 3rem;
  display: none;
}

.loading-spinner {
  width: 32px;
  height: 32px;
  border: 2px solid var(--border-color);
  border-top: 2px solid var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 0.75rem;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 灯箱 */
.image-lightbox {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.92);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  cursor: pointer;
}

.image-lightbox img {
  max-width: 90%;
  max-height: 90%;
  object-fit: contain;
  animation: lightboxZoom 0.25s ease-out;
}

.image-lightbox .close-btn {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  color: #fff;
  font-size: 1.8rem;
  cursor: pointer;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  background: rgba(255,255,255,0.1);
  transition: background 0.2s ease;
}

.image-lightbox .close-btn:hover {
  background: rgba(255,255,255,0.2);
}

@keyframes lightboxZoom {
  0% { transform: scale(0.9); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

@media (max-width: 768px) {
  .polaroid-wall {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .section-header h1 {
    font-size: 2rem;
  }
}

[data-theme="dark"] .polaroid-frame {
  background: var(--bg-secondary);
}
</style>

<!-- 图片灯箱组件 -->
<div class="image-lightbox" id="imageLightbox">
  <div class="close-btn" onclick="closeLightbox()">×</div>
  <img id="lightboxImage" src="" alt="">
</div>

<script>
// 相册交互功能
document.addEventListener('DOMContentLoaded', function() {
  const photos = document.querySelectorAll('.polaroid-photo');
  const lightbox = document.getElementById('imageLightbox');
  const lightboxImage = document.getElementById('lightboxImage');
  
  // 为每个照片添加点击事件
  photos.forEach(photo => {
    photo.addEventListener('click', function(e) {
      e.preventDefault();
      
      const img = this.querySelector('img');
      if (img) {
        openLightbox(img.src, img.alt);
      }
    });
    
    // 添加悬停音效（视觉反馈）
    photo.addEventListener('mouseenter', function() {
      this.style.zIndex = '10';
    });
    
    photo.addEventListener('mouseleave', function() {
      this.style.zIndex = 'auto';
    });
  });
  
  // 灯箱功能
  function openLightbox(src, alt) {
    lightboxImage.src = src;
    lightboxImage.alt = alt;
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  
  window.closeLightbox = function() {
    lightbox.style.display = 'none';
    document.body.style.overflow = 'auto';
  };
  
  // 点击背景关闭灯箱
  lightbox.addEventListener('click', function(e) {
    if (e.target === lightbox) {
      closeLightbox();
    }
  });
  
  // ESC键关闭灯箱
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeLightbox();
    }
  });
  

  

});
</script>