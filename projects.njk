---
layout: base.njk
title: 项目展示
description: 探索我的创意项目和技术实现
keywords: 项目, 作品集, 技术栈, 创意
---

<section class="projects-section">
  <div class="section-header">
    <h1 class="handwriting">时间胶囊</h1>
    <p class="section-subtitle">每一个项目都是一段记忆的封装</p>
  </div>
  
  <div class="projects-grid">
    {% for project in collections.projects %}
    <article class="time-capsule {% if loop.index % 2 == 0 %}even{% endif %}">
      <div class="capsule-content">
        {% if project.data.cover %}
        <div class="capsule-cover">
          <img src="{{ project.data.cover }}" alt="{{ project.data.title }}" loading="lazy">
          <div class="cover-overlay">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
        </div>
        {% endif %}
        
        <div class="capsule-info">
          <div class="capsule-date">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
              <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/>
            </svg>
            {{ project.data.date | date("yyyy年MM月") }}
          </div>
          
          <h2 class="capsule-title">{{ project.data.title }}</h2>
          <p class="capsule-description">{{ project.data.description }}</p>
          
          <div class="tech-stack">
            {% for tech in project.data.tech %}
            <span class="tech-badge">{{ tech }}</span>
            {% endfor %}
          </div>
          
          <div class="capsule-actions">
            <a href="{{ project.url | url }}" class="btn btn-primary">查看详情</a>
            {% if project.data.demo %}
            <a href="{{ project.data.demo }}" class="btn btn-secondary" target="_blank">在线演示</a>
            {% endif %}
          </div>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<style>
.projects-section {
  padding: 2rem 0;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-header h1 {
  font-size: 2.8rem;
  margin-bottom: 0.5rem;
}

.section-subtitle {
  font-size: 1.05rem;
  color: var(--text-secondary);
}

.projects-grid {
  display: grid;
  gap: 2rem;
  max-width: 1100px;
  margin: 0 auto;
}

.time-capsule {
  position: relative;
}

.capsule-content {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 1.5rem;
  padding: 1.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  transition: box-shadow 0.25s ease, transform 0.2s ease;
}

.time-capsule:hover .capsule-content {
  box-shadow: var(--shadow-md);
  transform: translateY(-3px);
}

.capsule-cover {
  position: relative;
  border-radius: 4px;
  overflow: hidden;
  aspect-ratio: 16/10;
  background: var(--bg-secondary);
}

.capsule-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.time-capsule:hover .capsule-cover img {
  transform: scale(1.05);
}

.capsule-info {
  display: flex;
  flex-direction: column;
}

.capsule-date {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--accent-warm);
  font-size: 0.85rem;
  margin-bottom: 0.6rem;
}

.capsule-title {
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 0.6rem;
  color: var(--text-primary);
  line-height: 1.3;
}

.capsule-description {
  color: var(--text-secondary);
  font-size: 0.92rem;
  line-height: 1.7;
  margin-bottom: 1rem;
  flex: 1;
}

.tech-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 1.25rem;
}

.tech-badge {
  background: var(--bg-secondary);
  color: var(--text-muted);
  padding: 0.2rem 0.6rem;
  border-radius: 3px;
  font-size: 0.78rem;
}

.capsule-actions {
  display: flex;
  gap: 0.75rem;
  align-items: center;
}

.capsule-actions .btn {
  padding: 0.45rem 1rem;
  font-size: 0.85rem;
}

/* 响应式 */
@media (max-width: 768px) {
  .projects-grid {
    gap: 1.5rem;
  }

  .capsule-content {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .capsule-title {
    font-size: 1.3rem;
  }

  .capsule-actions {
    flex-direction: column;
  }

  .capsule-actions .btn {
    width: 100%;
    justify-content: center;
  }
}

/* 入场 */
.time-capsule {
  opacity: 0;
  transform: translateY(20px);
  animation: capsuleFadeIn 0.5s ease-out forwards;
}

.time-capsule:nth-child(1) { animation-delay: 0.05s; }
.time-capsule:nth-child(2) { animation-delay: 0.1s; }
.time-capsule:nth-child(3) { animation-delay: 0.15s; }
.time-capsule:nth-child(4) { animation-delay: 0.2s; }

@keyframes capsuleFadeIn {
  to { opacity: 1; transform: translateY(0); }
}
</style>