<!DOCTYPE html>
<html lang="zh-CN" {% if site.theme %}data-theme="{{ site.theme }}"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} - {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
  <meta name="keywords" content="{% if keywords %}{{ keywords }}{% else %}{{ site.keywords }}{% endif %}">
  <meta name="author" content="{{ site.author }}">
  
  <!-- Open Graph -->
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  
  <!-- CSS -->
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
  <link rel="icon" type="image/x-icon" href="{{ '/assets/images/favicon.ico' | url }}">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {% if useAos %}
  <link rel="stylesheet" href="{{ '/assets/css/aos.css' | url }}">
  {% endif %}

  {% if page.url == "/" %}
  <style>
    .hero-section {
      min-height: 70vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      position: relative;
    }

    .signature {
      font-size: 3rem;
      font-family: 'Kalam', cursive;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
      opacity: 0;
      transform: translateY(20px);
      animation: signatureFadeIn 1s ease-out 0.3s forwards;
    }

    .motto {
      font-size: 1.1rem;
      color: var(--text-secondary);
      margin-bottom: 3rem;
      opacity: 0;
      transform: translateX(-30px);
      animation: mottoSlideIn 1s ease-out 0.6s forwards;
    }

    .hero-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      width: 100%;
      max-width: 960px;
      opacity: 0;
      transform: translateY(20px);
      animation: cardsFadeIn 1s ease-out 0.9s forwards;
    }

    @keyframes signatureFadeIn {
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes mottoSlideIn {
      to { opacity: 1; transform: translateX(0); }
    }

    @keyframes cardsFadeIn {
      to { opacity: 1; transform: translateY(0); }
    }

    .hero-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1.75rem;
      text-align: center;
      text-decoration: none;
      transition: box-shadow 0.25s ease, transform 0.2s ease;
    }

    .hero-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }

    .hero-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto 0.75rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .hero-card h3 {
      font-size: 1.15rem;
      margin-bottom: 0.35rem;
      color: var(--text-primary);
    }

    .hero-card p {
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.5;
    }
  </style>
  {% endif %}
</head>
<body>
  {% include 'header.njk' %}
  
  <main class="container">
    {% if page.url == "/" %}
    <section class="hero-section" style="padding-top: 20px;">
      <h1 class="signature">{{ site.signature }}</h1>
      <p class="motto">{{ site.motto }}</p>
      
      <div class="hero-cards">
        <a href="{{ '/blog/' | url }}" class="hero-card">
          <div class="hero-icon">B</div>
          <h3>博客</h3>
          <p>记录思考与成长的文字</p>
        </a>
        
        <a href="{{ '/projects/' | url }}" class="hero-card">
          <div class="hero-icon">P</div>
          <h3>项目</h3>
          <p>创意实现与技术探索</p>
        </a>
        
        <a href="{{ '/gallery/' | url }}" class="hero-card">
          <div class="hero-icon">G</div>
          <h3>相册</h3>
          <p>生活中的美好瞬间</p>
        </a>
      </div>
    </section>
    {% else %}
    {{ content | safe }}
    {% endif %}
  </main>
  
  {% include 'footer.njk' %}
  
  <!-- JavaScript -->
  <script src="{{ '/assets/js/theme.js' | url }}"></script>
  <script src="{{ '/assets/js/main.js' | url }}"></script>
  {% if useAos %}
  <script src="{{ '/assets/js/aos.js' | url }}"></script>
  {% endif %}
</body>
</html>
