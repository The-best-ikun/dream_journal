---
layout: base.njk
---

<section class="photo-detail">
  <article class="photo-content">
    <div class="photo-display">
      <img src="{{ image }}" alt="{{ title }}" loading="lazy">
    </div>
    
    <div class="photo-info">
      <h1 class="photo-title handwriting">{{ title }}</h1>
      
      <div class="photo-meta">
        <div class="meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/>
          </svg>
          <time datetime="{{ date | date("yyyy-MM-dd") }}">
            {{ date | date("yyyy年MM月dd日 HH:mm") }}
          </time>
        </div>
        
        <div class="meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>{{ location or '未记录' }}</span>
        </div>
      </div>
      
      <div class="photo-description">
        <h3 class="handwriting">💭 拍摄感言</h3>
        <div class="description-text">
          {{ content | safe }}
        </div>
      </div>
      
      {% if tags %}
      <div class="photo-tags">
        <h3 class="handwriting">🏷️ 标签</h3>
        <div class="tags-list">
          {% for tag in tags %}
          <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
  </article>
  
  <nav class="photo-navigation">
    <div class="nav-prev">
      {% if previousPhoto %}
      <a href="{{ previousPhoto.url }}" class="nav-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polyline points="15 18 9 12 15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <div class="nav-text">
          <span class="nav-label">上一张</span>
          <span class="nav-title">{{ previousPhoto.data.title }}</span>
        </div>
      </a>
      {% endif %}
    </div>
    
    <div class="nav-home">
      <a href="{{ '/gallery/' | url }}" class="nav-link">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="3" width="7" height="7" stroke="currentColor" stroke-width="2"/>
          <rect x="14" y="3" width="7" height="7" stroke="currentColor" stroke-width="2"/>
          <rect x="14" y="14" width="7" height="7" stroke="currentColor" stroke-width="2"/>
          <rect x="3" y="14" width="7" height="7" stroke="currentColor" stroke-width="2"/>
        </svg>
        <span>相册首页</span>
      </a>
    </div>
    
    <div class="nav-next">
      {% if nextPhoto %}
      <a href="{{ nextPhoto.url }}" class="nav-link">
        <div class="nav-text">
          <span class="nav-label">下一张</span>
          <span class="nav-title">{{ nextPhoto.data.title }}</span>
        </div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <polyline points="9 18 15 12 9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </a>
      {% endif %}
    </div>
  </nav>
</section>

<style>
.photo-detail {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem 0;
}

.photo-content {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 2.5rem;
  padding: 2rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  margin-bottom: 2rem;
}

.photo-display {
  position: relative;
  border-radius: 4px;
  overflow: hidden;
  background: var(--bg-secondary);
  aspect-ratio: 4/3;
  border: 1px solid var(--border-color);
}

.photo-display img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
  cursor: zoom-in;
  display: block;
}

.photo-display img:hover {
  transform: scale(1.03);
}

.photo-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.photo-title {
  font-size: 2rem;
  margin-bottom: 1rem;
  color: var(--text-primary);
  line-height: 1.2;
}

.photo-meta {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  color: var(--text-muted);
  font-size: 0.88rem;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.photo-description {
  margin-bottom: 1.5rem;
}

.photo-description h3 {
  font-size: 1rem;
  font-weight: 500;
  margin-bottom: 0.6rem;
  color: var(--text-primary);
}

.description-text {
  color: var(--text-secondary);
  font-size: 0.95rem;
  line-height: 1.7;
}

.photo-tags {
  margin-bottom: 1.5rem;
}

.photo-tags h3 {
  font-size: 1rem;
  font-weight: 500;
  margin-bottom: 0.6rem;
  color: var(--text-primary);
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.photo-tags .tag {
  background: var(--bg-secondary);
  color: var(--text-muted);
  padding: 0.2rem 0.6rem;
  border-radius: 3px;
  font-size: 0.8rem;
}

.photo-navigation {
  padding: 1.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 1.5rem;
  align-items: center;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: var(--text-secondary);
  text-decoration: none;
  padding: 0.6rem 0.8rem;
  border-radius: 4px;
  transition: all 0.2s ease;
  font-size: 0.9rem;
}

.nav-link:hover {
  background: var(--bg-secondary);
  color: var(--accent);
}

.nav-text {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}

.nav-label {
  font-size: 0.78rem;
  color: var(--text-muted);
}

.nav-title {
  font-weight: 500;
  font-size: 0.9rem;
  line-height: 1.3;
}

.nav-home {
  text-align: center;
}

.nav-home .nav-link {
  flex-direction: column;
  gap: 0.3rem;
}

.nav-prev .nav-link {
  justify-content: flex-start;
}

.nav-next .nav-link {
  justify-content: flex-end;
  text-align: right;
}

/* 全屏查看 */
.fullscreen-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  cursor: pointer;
}

.fullscreen-overlay.active {
  display: flex;
}

.fullscreen-overlay img {
  max-width: 95%;
  max-height: 95%;
  object-fit: contain;
  animation: zoomIn 0.25s ease-out;
}

@keyframes zoomIn {
  0% { transform: scale(0.9); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.fullscreen-close {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  color: #fff;
  font-size: 1.8rem;
  cursor: pointer;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  background: rgba(255,255,255,0.1);
  transition: background 0.2s ease;
}

.fullscreen-close:hover {
  background: rgba(255,255,255,0.2);
}

@media (max-width: 968px) {
  .photo-content {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .photo-display {
    order: -1;
  }

  .photo-title {
    font-size: 1.6rem;
  }
}

@media (max-width: 768px) {
  .photo-content {
    padding: 1.5rem;
  }

  .photo-navigation {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .nav-home {
    order: -1;
  }

  .nav-prev .nav-link,
  .nav-next .nav-link {
    justify-content: center;
  }
}
</style>

<!-- 全屏图片查看组件 -->
<div class="fullscreen-overlay" id="fullscreenOverlay">
  <div class="fullscreen-close" onclick="closeFullscreen()">×</div>
  <img id="fullscreenImage" src="" alt="">
</div>

<script>
// 照片详情页交互功能
document.addEventListener('DOMContentLoaded', function() {
  const photoDisplay = document.querySelector('.photo-display img');
  const fullscreenOverlay = document.getElementById('fullscreenOverlay');
  const fullscreenImage = document.getElementById('fullscreenImage');
  
  // 点击图片查看全屏
  if (photoDisplay) {
    photoDisplay.addEventListener('click', function() {
      openFullscreen(this.src, this.alt);
    });
  }
  
  // 全屏查看功能
  function openFullscreen(src, alt) {
    fullscreenImage.src = src;
    fullscreenImage.alt = alt;
    fullscreenOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  
  window.closeFullscreen = function() {
    fullscreenOverlay.classList.remove('active');
    document.body.style.overflow = 'auto';
  };
  
  // 点击背景关闭全屏
  fullscreenOverlay.addEventListener('click', function(e) {
    if (e.target === fullscreenOverlay) {
      closeFullscreen();
    }
  });
  
  // ESC键关闭全屏
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeFullscreen();
    }
  });
  
  // 键盘导航
  document.addEventListener('keydown', function(e) {
    if (fullscreenOverlay.classList.contains('active')) {
      return; // 全屏模式下不响应键盘导航
    }
    
    const prevLink = document.querySelector('.nav-prev .nav-link');
    const nextLink = document.querySelector('.nav-next .nav-link');
    
    if (e.key === 'ArrowLeft' && prevLink) {
      prevLink.click();
    } else if (e.key === 'ArrowRight' && nextLink) {
      nextLink.click();
    }
  });
  
  // 图片加载动画
  const images = document.querySelectorAll('img');
  images.forEach(img => {
    img.style.opacity = '0';
    img.addEventListener('load', function() {
      this.style.transition = 'opacity 0.5s ease';
      this.style.opacity = '1';
    });
    
    // 处理已经缓存的图片
    if (img.complete) {
      img.style.opacity = '1';
    }
  });
});
</script>