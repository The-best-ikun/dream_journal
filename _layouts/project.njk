---
layout: base.njk
---

<section class="project-detail">
  <article class="article-content">
    <header class="article-header">
      <h1 class="article-title">{{ title }}</h1>

      <div class="article-meta">
        <div class="meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>{{ date | date("yyyy年MM月dd日") }}</span>
        </div>

        {% if tech %}
        <div class="meta-item">
          <div class="tech-badges">
            {% for t in tech %}
            <span class="tech-badge">{{ t }}</span>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {% if demo %}
        <div class="meta-item">
          <a href="{{ demo }}" class="btn btn-primary" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
            </svg>
            在线演示
          </a>
        </div>
        {% endif %}
      </div>
    </header>

    {% if cover %}
    <div class="project-hero">
      <img src="{{ cover }}" alt="{{ title }}" loading="lazy">
    </div>
    {% endif %}

    <div class="article-body">
      {{ content | safe }}
    </div>

    {% if challenges or solutions or role or results %}
    <section class="project-details">
      {% if challenges %}
      <div class="detail-section">
        <h2>项目挑战</h2>
        <div>{{ challenges }}</div>
      </div>
      {% endif %}

      {% if solutions %}
      <div class="detail-section">
        <h2>解决方案</h2>
        <div>{{ solutions }}</div>
      </div>
      {% endif %}

      {% if role %}
      <div class="detail-section">
        <h2>我的角色</h2>
        <div>{{ role }}</div>
      </div>
      {% endif %}

      {% if results %}
      <div class="detail-section">
        <h2>成果与反思</h2>
        <div>{{ results }}</div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    {% if github %}
    <section class="project-footer">
      <div class="project-links">
        <a href="{{ github }}" class="btn btn-secondary" target="_blank">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          查看源码
        </a>

        {% if demo %}
        <a href="{{ demo }}" class="btn btn-primary" target="_blank">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
          </svg>
          在线体验
        </a>
        {% endif %}
      </div>
    </section>
    {% endif %}
  </article>
</section>

<style>
.project-detail {
  max-width: 920px;
  margin: 0 auto;
  padding: 2rem 0;
}

.article-content {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 3rem;
  margin-bottom: 2rem;
}

.article-header {
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--divider);
}

.article-title {
  font-size: 2.2rem;
  font-weight: 700;
  margin-bottom: 1.25rem;
  color: var(--text-primary);
  line-height: 1.25;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  align-items: center;
  font-size: 0.88rem;
  color: var(--text-muted);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.tech-badges {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.tech-badge {
  background: var(--bg-secondary);
  color: var(--text-muted);
  padding: 0.2rem 0.6rem;
  border-radius: 3px;
  font-size: 0.8rem;
}

.project-hero {
  margin: 1.5rem 0;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid var(--border-color);
}

.project-hero img {
  width: 100%;
  height: auto;
  display: block;
}

.article-body {
  font-size: 1.05rem;
  line-height: 1.85;
  color: var(--text-primary);
  margin: 1.5rem 0;
}

.article-body h2 {
  font-size: 1.6rem;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid var(--divider);
}

.article-body h3 {
  font-size: 1.3rem;
  margin-top: 2rem;
  margin-bottom: 0.8rem;
}

.article-body p {
  margin-bottom: 1.2rem;
}

.article-body ul,
.article-body ol {
  margin-bottom: 1.2rem;
  padding-left: 1.5rem;
}

.article-body li {
  margin-bottom: 0.4rem;
}

.article-body blockquote {
  margin: 1.5rem 0;
  padding: 1rem 1.5rem;
  background: var(--bg-secondary);
  border-left: 3px solid var(--accent-warm);
  border-radius: 0 6px 6px 0;
  color: var(--text-secondary);
  font-style: italic;
}

.article-body code {
  background: var(--bg-secondary);
  padding: 0.2rem 0.4rem;
  border-radius: 3px;
  font-family: 'SF Mono', 'Cascadia Code', 'Consolas', monospace;
  font-size: 0.88em;
  color: var(--accent-warm);
}

.project-details {
  margin: 2.5rem 0;
  padding: 1.5rem 2rem;
  background: var(--bg-secondary);
  border-radius: 6px;
  border-left: 3px solid var(--accent);
}

.detail-section {
  margin-bottom: 1.5rem;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.detail-section h2 {
  font-size: 1.15rem;
  margin-bottom: 0.6rem;
  color: var(--text-primary);
}

.detail-section p {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--text-secondary);
}

.project-footer {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--divider);
}

.project-links {
  display: flex;
  gap: 1rem;
  justify-content: center;
}

@media (max-width: 768px) {
  .article-content {
    padding: 1.5rem;
  }

  .article-title {
    font-size: 1.7rem;
  }

  .article-meta {
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .project-links {
    flex-direction: column;
  }

  .project-links .btn {
    justify-content: center;
  }
}
</style>