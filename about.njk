<script>
// 技能雷达图
document.addEventListener('DOMContentLoaded', function() {
  const canvas = document.getElementById('skillsCanvas');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  const W = canvas.width;
  const H = canvas.height;

  // 技能数据 — 半径方向排序，共 8 项
  const skills = [
    { name: 'JavaScript',  level: 90, color: '#5C8D89' },
    { name: 'React',       level: 85, color: '#7FB5B0' },
    { name: 'Vue',         level: 80, color: '#6BA3A0' },
    { name: 'Node.js',     level: 75, color: '#C8826E' },
    { name: 'CSS',         level: 85, color: '#D49484' },
    { name: 'TypeScript',  level: 70, color: '#7FB5B0' },
    { name: 'Python',      level: 65, color: '#C8826E' },
    { name: 'Docker',      level: 60, color: '#6BA3A0' }
  ];

  const count = skills.length;
  const cx = W / 2;
  const cy = H / 2;
  const radius = Math.min(W, H) * 0.35;

  // 获取 CSS 变量
  function cssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    const textColor = cssVar('--text-primary') || '#2C2416';
    const mutedColor = cssVar('--text-muted') || '#9C8F7E';
    const borderColor = cssVar('--border-color') || '#E3DCD0';

    // --- 网格：5 层同心多边形 ---
    const layers = 5;
    for (let l = 1; l <= layers; l++) {
      const r = (radius / layers) * l;
      ctx.beginPath();
      for (let i = 0; i < count; i++) {
        const angle = (Math.PI * 2 / count) * i - Math.PI / 2;
        const x = cx + r * Math.cos(angle);
        const y = cy + r * Math.sin(angle);
        i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.strokeStyle = l === layers ? borderColor : borderColor;
      ctx.lineWidth = l === layers ? 0.5 : 0.5;
      ctx.stroke();
    }

    // --- 辐射线 ---
    for (let i = 0; i < count; i++) {
      const angle = (Math.PI * 2 / count) * i - Math.PI / 2;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + radius * Math.cos(angle), cy + radius * Math.sin(angle));
      ctx.strokeStyle = borderColor;
      ctx.lineWidth = 0.5;
      ctx.stroke();
    }

    // --- 数据区域 ---
    ctx.beginPath();
    for (let i = 0; i < count; i++) {
      const angle = (Math.PI * 2 / count) * i - Math.PI / 2;
      const level = skills[i].level / 100;
      const r = radius * level;
      const x = cx + r * Math.cos(angle);
      const y = cy + r * Math.sin(angle);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.closePath();

    // 半透明填充
    const accent = cssVar('--accent') || '#5C8D89';
    ctx.fillStyle = accent + '20';
    ctx.fill();

    // 数据线描边
    ctx.strokeStyle = accent;
    ctx.lineWidth = 2;
    ctx.stroke();

    // --- 数据点 ---
    for (let i = 0; i < count; i++) {
      const angle = (Math.PI * 2 / count) * i - Math.PI / 2;
      const level = skills[i].level / 100;
      const r = radius * level;
      const x = cx + r * Math.cos(angle);
      const y = cy + r * Math.sin(angle);

      ctx.beginPath();
      ctx.arc(x, y, 4, 0, Math.PI * 2);
      ctx.fillStyle = skills[i].color;
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    // --- 标签 ---
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    for (let i = 0; i < count; i++) {
      const angle = (Math.PI * 2 / count) * i - Math.PI / 2;
      const labelR = radius + 28;
      const x = cx + labelR * Math.cos(angle);
      const y = cy + labelR * Math.sin(angle);

      ctx.font = '13px Noto Sans SC, sans-serif';
      ctx.fillStyle = textColor;
      ctx.fillText(skills[i].name, x, y - 7);

      ctx.font = '10px Noto Sans SC, sans-serif';
      ctx.fillStyle = mutedColor;
      ctx.fillText(skills[i].level + '%', x, y + 10);
    }

    // --- 中心百分比刻度（最外层标 100%）---
    ctx.font = '9px Noto Sans SC, sans-serif';
    ctx.fillStyle = mutedColor;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'bottom';
    // 右上角标注
    ctx.fillText('100%', cx + radius + 4, cy - 2);
  }

  draw();

  // 响应式
  function resizeCanvas() {
    const container = canvas.parentElement;
    const w = container.offsetWidth;
    if (w < 520) {
      canvas.style.width = w + 'px';
      canvas.style.height = w + 'px';
    } else {
      canvas.style.width = '';
      canvas.style.height = '';
    }
  }

  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();
});
</script>