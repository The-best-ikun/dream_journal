<style>
.site-footer {
  margin-top: 3rem;
  border-top: 1px solid var(--border-color);
  background: var(--bg-secondary);
}

.footer-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  padding: 1.25rem 0;
}

.footer-section h3,
.footer-section h4 {
  margin-bottom: 0.5rem;
  color: var(--text-primary);
}

.footer-section h3 {
  font-size: 1.2rem;
}

.footer-section h4 {
  font-size: 0.9rem;
  font-weight: 500;
  letter-spacing: 0.05em;
}

.social-links {
  display: flex;
  gap: 0.5rem;
}

.social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 4px;
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.social-link:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  transform: translateY(-1px);
}

.link-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.15rem 1rem;
  list-style: none;
  padding: 0;
  margin-bottom: 0.5rem;
}

.link-grid a {
  color: var(--text-secondary);
  font-size: 0.85rem;
  text-decoration: none;
  transition: color 0.2s ease;
}

.link-grid a:hover {
  color: var(--accent);
}

.link-grid a.external-link::after {
  content: '↗';
  font-size: 0.7rem;
  margin-left: 2px;
  vertical-align: super;
  color: var(--accent);
}

.footer-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 0.15rem 1rem;
  font-size: 0.78rem;
  color: var(--text-muted);
}

.footer-stats strong {
  font-weight: 600;
  color: var(--accent);
}

.footer-bottom {
  border-top: 1px solid var(--border-color);
  padding: 0.6rem 0;
  text-align: center;
}

.footer-bottom p {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.8rem;
}

@media (max-width: 640px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 1rem 0;
  }
}
</style>