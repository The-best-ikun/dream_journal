<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-section">
      <h3 class="handwriting">{{ site.title }}</h3>
      <div class="social-links">
        <button type="button" class="social-link" aria-label="显示 QQ 号" data-reveal="QQ：{{ site.qq }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21.395 15.035a40 40 0 0 0-.803-2.264l-1.079-2.695c.001-.032.014-.562.014-.836C19.526 4.632 17.351 0 12 0S4.474 4.632 4.474 9.241c0 .274.013.804.014.836l-1.08 2.695a39 39 0 0 0-.802 2.264c-1.021 3.283-.69 4.643-.438 4.673.54.065 2.103-2.472 2.103-2.472 0 1.469.756 3.387 2.394 4.771-.612.188-1.363.479-1.845.835-.434.32-.379.646-.301.778.343.578 5.883.369 7.482.189 1.6.18 7.14.389 7.483-.189.078-.132.132-.458-.301-.778-.483-.356-1.233-.646-1.846-.836 1.637-1.384 2.393-3.302 2.393-4.771 0 0 1.563 2.537 2.103 2.472.251-.03.581-1.39-.438-4.673"/>
          </svg>
        </button>
        <button type="button" class="social-link" aria-label="显示邮箱" data-reveal="邮箱：{{ site.email }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </button>
      </div>
      <p class="social-reveal" id="socialReveal" hidden></p>
      <script>
        document.querySelectorAll('.social-links [data-reveal]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var p = document.getElementById('socialReveal');
            p.textContent = btn.getAttribute('data-reveal');
            p.hidden = false;
          });
        });
      </script>
    </div>

    <div class="footer-section">
      <h4>快速链接</h4>
      <ul class="link-grid">
        <li><a href="{{ '/about/' | url }}">关于我</a></li>
        <li><a href="{{ '/intro/' | url }}" class="external-link" target="_blank" rel="noopener noreferrer">自我介绍</a></li>
        <li><a href="{{ '/blog/' | url }}">博客</a></li>
        <li><a href="{{ '/projects/' | url }}">项目</a></li>
        <li><a href="{{ '/gallery/' | url }}">相册</a></li>
      </ul>
      <div class="footer-stats">
        <span>已运行 <strong id="daysRunning">0</strong> 天</span>
        <span>记录了 <strong id="thoughtsCount">0</strong> 个想法</span>
        <span>收录了 <strong id="momentsCount">0</strong> 个瞬间</span>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {{ "now" | date("YYYY") }} {{ site.title }}</p>
    </div>
  </div>
</footer>

<style>
.site-footer {
  margin-top: 3rem;
  border-top: 1px solid var(--border-color);
  background: var(--bg-secondary);
}

.footer-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  padding: 1.25rem 0;
}

.footer-section h3,
.footer-section h4 {
  margin-bottom: 0.5rem;
  color: var(--text-primary);
}

.footer-section h3 {
  font-size: 1.2rem;
}

.footer-section h4 {
  font-size: 0.9rem;
  font-weight: 500;
  letter-spacing: 0.05em;
}

.social-links {
  display: flex;
  gap: 0.5rem;
}

.social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border-radius: 4px;
  border: 1px solid var(--border-color);
  background: none;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all 0.2s ease;
}

.social-reveal {
  margin: 0.6rem 0 0;
  font-size: 0.82rem;
  color: var(--text-secondary);
  word-break: break-all;
}

.social-link:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  transform: translateY(-1px);
}

.link-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.15rem 1rem;
  list-style: none;
  padding: 0;
  margin-bottom: 0.5rem;
}

.link-grid a {
  color: var(--text-secondary);
  font-size: 0.85rem;
  text-decoration: none;
  transition: color 0.2s ease;
}

.link-grid a:hover {
  color: var(--accent);
}

.link-grid a.external-link::after {
  content: '↗';
  font-size: 0.7rem;
  margin-left: 2px;
  vertical-align: super;
  color: var(--accent);
}

.footer-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 0.15rem 1rem;
  font-size: 0.78rem;
  color: var(--text-muted);
}

.footer-stats strong {
  font-weight: 600;
  color: var(--accent);
}

.footer-bottom {
  border-top: 1px solid var(--border-color);
  padding: 0.6rem 0;
  text-align: center;
}

.footer-bottom p {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.8rem;
}

@media (max-width: 640px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 1rem 0;
  }
}
</style>