---
layout: base.njk
title: 博客
description: 记录思考、技术与生活的点点滴滴
keywords: 博客, 文章, 思考, 技术, 生活
---

<section class="blog-section">
  <div class="section-header">
    <h1 class="handwriting">随笔</h1>
    <p class="section-subtitle">随便写写，想到哪记到哪，都是些不成熟的碎碎念</p>
  </div>
  
  <div class="blog-filters">
    <div class="filter-group filter-search">
      <h3>搜索文章</h3>
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
          <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input type="text" id="searchInput" placeholder="搜索标题、正文或标签..." autocomplete="off">
        <button type="button" class="search-clear" id="searchClear" style="display: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="filter-group">
      <h3>心情标签</h3>
      <div class="mood-filters" id="moodFilters">
        <button class="filter-btn active" data-mood="all">
          全部
        </button>
        <button class="filter-btn" data-mood="思考">
          思考
        </button>
        <button class="filter-btn" data-mood="技术">
          技术
        </button>
        <button class="filter-btn" data-mood="生活">
          生活
        </button>
      </div>
    </div>
    
    <div class="filter-group">
      <h3>技术标签</h3>
      <div class="tag-filters" id="tagFilters">
        <button class="filter-btn active" data-tag="all">全部</button>
        <button class="filter-btn" data-tag="JavaScript">JavaScript</button>
        <button class="filter-btn" data-tag="CSS">CSS</button>
        <button class="filter-btn" data-tag="React">React</button>
        <button class="filter-btn" data-tag="Vue">Vue</button>
        <button class="filter-btn" data-tag="设计">设计</button>
        <button class="filter-btn" data-tag="生活">生活</button>
      </div>
    </div>
  </div>
  
  <div class="blog-posts" id="blogPosts">
    {% for post in collections.posts %}
    <article class="blog-post"
             data-mood="{{ post.data.mood or '思考' }}"
             data-tags="{{ post.data.tags | join(',') }}"
             data-title="{{ post.data.title }}"
             data-search="{{ [post.data.title, post.data.description, (post.data.tags | join(' ')), post.templateContent] | join(' ') | striptags | lower }}">
      <div class="post-header">
        <div class="post-mood">
          <span class="mood-label">{{ post.data.mood or '思考' }}</span>
        </div>
        
        <div class="post-meta">
          <time datetime="{{ post.date | date("yyyy-MM-dd") }}">
            {{ post.date | date("yyyy年MM月dd日") }}
          </time>
          <span class="reading-time">阅读时间：{{ post.data.readingTime or '5' }}分钟</span>
        </div>
      </div>
      
      <div class="post-content">
        <h2 class="post-title">
          <a href="{{ post.url }}">{{ post.data.title }}</a>
        </h2>
        
        <p class="post-excerpt">{{ post.data.description or post.content | striptags | truncate(150) }}</p>
        
        {% if post.data.tags %}
        <div class="post-tags">
          {% for tag in post.data.tags %}
          <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      
      <div class="post-footer">
        <a href="{{ post.url | url }}" class="read-more-btn">
          阅读全文
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 12h14m-7-7l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </article>
    {% endfor %}
  </div>
  
  <div class="no-results" id="noResults" style="display: none;">
    <div class="card">
      <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="2"/>
        <path d="M21 21l-4.35-4.35M11 8v6m3-3H8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <h3>暂无相关文章</h3>
      <p>试试其他标签或心情吧</p>
    </div>
  </div>
</section>

<style>
.blog-section {
  padding: 2rem 0;
  max-width: 1100px;
  margin: 0 auto;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-header h1 {
  font-size: 2.8rem;
  margin-bottom: 0.5rem;
}

.section-subtitle {
  font-size: 1.05rem;
  color: var(--text-secondary);
}

.blog-filters {
  margin-bottom: 2.5rem;
  padding: 1.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
}

.filter-group {
  margin-bottom: 1rem;
}

.filter-group:last-child {
  margin-bottom: 0;
}

.filter-group h3 {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-muted);
  letter-spacing: 0.05em;
  margin-bottom: 0.6rem;
}

.filter-search {
  margin-bottom: 1.2rem;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 12px;
  color: var(--text-muted);
  pointer-events: none;
  transition: color 0.2s ease;
}

.search-box:focus-within .search-icon {
  color: var(--accent);
}

#searchInput {
  width: 100%;
  padding: 0.6rem 2.5rem 0.6rem 2.3rem;
  border: 1px solid var(--border-color);
  background: var(--bg-primary);
  color: var(--text-primary);
  border-radius: 6px;
  font-size: 0.9rem;
  font-family: inherit;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

#searchInput::placeholder {
  color: var(--text-muted);
}

#searchInput:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(var(--accent-rgb, 74, 144, 226), 0.15);
}

.search-clear {
  position: absolute;
  right: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border: none;
  background: none;
  color: var(--text-muted);
  cursor: pointer;
  border-radius: 50%;
  transition: color 0.2s ease, background 0.2s ease;
}

.search-clear:hover {
  color: var(--text-primary);
  background: var(--bg-secondary);
}

.mood-filters,
.tag-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.filter-btn {
  padding: 0.4rem 0.9rem;
  border: 1px solid var(--border-color);
  background: var(--bg-primary);
  color: var(--text-secondary);
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 0.85rem;
  font-weight: 400;
  font-family: inherit;
}

.filter-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.filter-btn.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.blog-posts {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.blog-post {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1.75rem;
  transition: box-shadow 0.25s ease, transform 0.2s ease;
}

.blog-post:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.post-mood {
  font-size: 0.85rem;
  color: var(--accent-warm);
  font-weight: 500;
}

.post-meta {
  display: flex;
  gap: 1rem;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.post-title {
  margin-bottom: 0.5rem;
}

.post-title a {
  color: var(--text-primary);
  text-decoration: none;
  font-size: 1.35rem;
  font-weight: 600;
  line-height: 1.3;
  transition: color 0.2s ease;
}

.post-title a:hover {
  color: var(--accent);
}

.post-excerpt {
  color: var(--text-secondary);
  font-size: 0.92rem;
  line-height: 1.7;
  margin-bottom: 1rem;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 1rem;
}

.tag {
  background: var(--bg-secondary);
  color: var(--text-muted);
  padding: 0.2rem 0.6rem;
  border-radius: 3px;
  font-size: 0.78rem;
  transition: color 0.2s ease, background 0.2s ease;
}

.tag:hover {
  background: var(--accent);
  color: #fff;
}

.post-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 0.75rem;
  border-top: 1px solid var(--divider);
}

.read-more-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  color: var(--accent);
  font-size: 0.88rem;
  font-weight: 500;
  transition: gap 0.2s ease;
}

.read-more-btn:hover {
  gap: 0.7rem;
  color: var(--accent-hover);
}

.no-results {
  text-align: center;
  padding: 3rem;
}

.no-results .card {
  display: inline-block;
  padding: 3rem;
}

.no-results svg {
  color: var(--text-muted);
  margin-bottom: 1rem;
}

.no-results h3 {
  font-size: 1.3rem;
  margin-bottom: 0.5rem;
}

.no-results p {
  color: var(--text-secondary);
}

/* 入场动画 */
.blog-post {
  opacity: 0;
  transform: translateY(20px);
  animation: postFadeIn 0.5s ease-out forwards;
}

.blog-post:nth-child(1) { animation-delay: 0.05s; }
.blog-post:nth-child(2) { animation-delay: 0.1s; }
.blog-post:nth-child(3) { animation-delay: 0.15s; }
.blog-post:nth-child(4) { animation-delay: 0.2s; }
.blog-post:nth-child(5) { animation-delay: 0.25s; }
.blog-post:nth-child(6) { animation-delay: 0.3s; }

@keyframes postFadeIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.blog-post.hidden {
  display: none;
}

@media (max-width: 768px) {
  .blog-posts {
    gap: 1rem;
  }

  .blog-post {
    padding: 1.25rem;
  }

  .post-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const moodButtons = document.querySelectorAll('#moodFilters .filter-btn');
  const tagButtons = document.querySelectorAll('#tagFilters .filter-btn');
  const blogPosts = document.querySelectorAll('.blog-post');
  const noResults = document.getElementById('noResults');
  const searchInput = document.getElementById('searchInput');
  const searchClear = document.getElementById('searchClear');
  
  let currentMood = 'all';
  let currentTag = 'all';
  let currentKeyword = '';

  function applyFilter(buttons, activeBtn, key) {
    buttons.forEach(btn => btn.classList.remove('active'));
    activeBtn.classList.add('active');
    if (key === 'mood') currentMood = activeBtn.dataset.mood;
    if (key === 'tag') currentTag = activeBtn.dataset.tag;
    filterPosts();
  }
  
  moodButtons.forEach(button => {
    button.addEventListener('click', () => applyFilter(moodButtons, button, 'mood'));
  });
  
  tagButtons.forEach(button => {
    button.addEventListener('click', () => applyFilter(tagButtons, button, 'tag'));
  });

  searchInput.addEventListener('input', function() {
    currentKeyword = this.value.trim().toLowerCase();
    searchClear.style.display = currentKeyword ? 'flex' : 'none';
    filterPosts();
  });

  searchInput.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      this.value = '';
      currentKeyword = '';
      searchClear.style.display = 'none';
      filterPosts();
    }
  });

  searchClear.addEventListener('click', function() {
    searchInput.value = '';
    currentKeyword = '';
    this.style.display = 'none';
    searchInput.focus();
    filterPosts();
  });
  
  function filterPosts() {
    let visibleCount = 0;
    
    blogPosts.forEach(post => {
      const postMood = post.dataset.mood;
      const postTags = post.dataset.tags || '';
      const postSearch = (post.dataset.search || '').toLowerCase();

      const moodMatch = currentMood === 'all' || postMood === currentMood;
      const tagMatch = currentTag === 'all' || postTags.includes(currentTag);
      const keywordMatch = !currentKeyword || postSearch.includes(currentKeyword);
      
      if (moodMatch && tagMatch && keywordMatch) {
        post.classList.remove('hidden');
        post.style.display = 'block';
        visibleCount++;
      } else {
        post.classList.add('hidden');
        post.style.display = 'none';
      }
    });
    
    noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    reanimateVisiblePosts();
  }
  
  function reanimateVisiblePosts() {
    let delay = 0.1;
    blogPosts.forEach(post => {
      if (!post.classList.contains('hidden')) {
        post.style.animation = 'none';
        post.offsetHeight;
        post.style.animation = `postFadeIn 0.6s ease-out ${delay}s forwards`;
        delay += 0.1;
      }
    });
  }
});
</script>